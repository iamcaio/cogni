        <div class="bg-white rounded-xl border border-notion-border shadow-2xl w-full max-w-md overflow-hidden flex flex-col text-xs my-auto">
            <div class="p-4 border-b border-notion-border flex items-center justify-between bg-notion-sidebar">
                <h3 class="text-sm font-bold text-gray-800 flex items-center gap-2">
                    <i class="fa-solid fa-arrows-rotate text-indigo-600"></i>
                    <span>Atualizacao do Cogni</span>
                </h3>
                <button type="button" onclick="closeModal('update-modal')" class="text-notion-muted hover:text-gray-800"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="p-5 space-y-4">
                <div id="update-modal-body">
                    <p class="text-gray-600 text-xs">Consultando atualizacoes disponiveis...</p>
                </div>
                <div id="update-progress-box" class="hidden space-y-2 pt-2 border-t border-gray-100">
                    <div class="flex justify-between items-center text-[11px] font-semibold text-gray-700">
                        <span id="update-progress-label">Baixando atualizacao...</span>
                        <span id="update-progress-pct" class="font-mono text-indigo-600">0%</span>
                    </div>
                    <div class="w-full bg-gray-200 h-2 rounded-full overflow-hidden">
                        <div id="update-progress-bar" class="bg-indigo-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                    <p id="update-progress-submsg" class="text-[10px] text-gray-500 font-mono truncate"></p>
                </div>
                <div class="pt-3 border-t flex justify-between items-center">
                    <button type="button" onclick="checkUpdateManual()" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 border rounded font-medium transition text-gray-700">
                        <i class="fa-solid fa-rotate mr-1"></i> Verificar Agora
                    </button>
                    <div class="flex space-x-2">
                        <button type="button" onclick="closeModal('update-modal')" class="px-3 py-1.5 border rounded">Fechar</button>
                        <button type="button" id="btn-install-update-now" onclick="installUpdateNow()" class="hidden px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded shadow-sm transition">
                            Atualizar Agora
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style id="accent-theme-styles">
        .accent-text-color { color: #4f46e5; }
        .accent-bg-badge { background-color: #4f46e5; }
        .accent-btn-bg { background-color: #4f46e5; }
        .accent-icon-color { color: #4f46e5; }
        .accent-border-color { border-color: #c7d2fe; }
        .accent-light-bg { background-color: #eef2ff; }
    </style>

    <script>
        const DEVOPS_ICONS = [
            { id: 'fa-solid fa-book', label: 'Livro' },
            { id: 'fa-solid fa-graduation-cap', label: 'Graduacao' },
            { id: 'fa-solid fa-pen-nib', label: 'Redacao' },
            { id: 'fa-solid fa-calculator', label: 'Calculo' },
            { id: 'fa-solid fa-flask', label: 'Laboratorio' },
            { id: 'fa-solid fa-microscope', label: 'Pesquisa' },
            { id: 'fa-solid fa-compass', label: 'Geografia' },
            { id: 'fa-solid fa-brain', label: 'Conhecimento' },
            { id: 'fa-solid fa-briefcase', label: 'Gestao' },
            { id: 'fa-solid fa-chart-line', label: 'Financas' },
            { id: 'fa-solid fa-sitemap', label: 'Organograma' },
            { id: 'fa-solid fa-handshake', label: 'Negocios' },
            { id: 'fa-solid fa-coins', label: 'Economia' },
            { id: 'fa-solid fa-bullseye', label: 'Metas / KPIs' },
            { id: 'fa-solid fa-users-gear', label: 'RH' },
            { id: 'fa-solid fa-boxes-stacked', label: 'Logistica' }
        ];
        let appData = {
            userProfile: { name: '', role: '', avatarPhoto: '' },
            accentTheme: 'indigo',
            subjects: [],
            selectedSubjectIdsForDelete: [],
            tasks: [],
            selectedTaskIds: [],
            flashcardDecks: [],
            selectedDeckIds: [],
            notes: [],
            selectedNoteIds: [],
            postits: [],
            studyLogs: []
        };
        const THEME_PALETTES = {
            indigo: { text: '#4f46e5', bg: '#4f46e5', border: '#c7d2fe', light: '#eef2ff', chartPalette: ['#4f46e5', '#06b6d4', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#64748b'] },
            rose: { text: '#e11d48', bg: '#e11d48', border: '#fecdd3', light: '#fff1f2', chartPalette: ['#e11d48', '#f59e0b', '#10b981', '#06b6d4', '#8b5cf6', '#3b82f6', '#64748b'] },
            cyan: { text: '#0284c7', bg: '#0284c7', border: '#bae6fd', light: '#f0f9ff', chartPalette: ['#0284c7', '#10b981', '#6366f1', '#f59e0b', '#ec4899', '#8b5cf6', '#64748b'] },
            emerald: { text: '#059669', bg: '#059669', border: '#a7f3d0', light: '#ecfdf5', chartPalette: ['#059669', '#0284c7', '#f59e0b', '#8b5cf6', '#ec4899', '#6366f1', '#64748b'] },
            amber: { text: '#d97706', bg: '#d97706', border: '#fde68a', light: '#fffbeb', chartPalette: ['#d97706', '#059669', '#0284c7', '#e11d48', '#8b5cf6', '#6366f1', '#64748b'] }
        };

        function changeAccentTheme(themeKey) {
            appData.accentTheme = themeKey;
            applyAccentTheme(themeKey);
            renderDashboardStats();
            updateCharts();
            triggerAutoSave();
        }

        function applyAccentTheme(themeKey) {
            const pal = THEME_PALETTES[themeKey] || THEME_PALETTES.indigo;
            const styleEl = document.getElementById('accent-theme-styles');
            if (styleEl) {
                styleEl.innerHTML = `
                    .accent-text-color { color: ${pal.text} !important; }
                    .accent-bg-badge { background-color: ${pal.bg} !important; }
                    .accent-btn-bg { background-color: ${pal.bg} !important; }
                    .accent-icon-color { color: ${pal.text} !important; }
                    .accent-border-color { border-color: ${pal.border} !important; }
                    .accent-light-bg { background-color: ${pal.light} !important; }
                `;
            }
            const sel = document.getElementById('accent-theme-select');
            if (sel) sel.value = themeKey;
        }

        let isAppDataLoadedFromDisk = false;
        let isInitializingFromDisk = false;
        let activeSubjectFilter = 'ALL';
        let currentActiveNoteId = null;
        let activeTasksViewMode = 'table';
        let timerSeconds = 25 * 60;
        let timerDurationConfigured = 25 * 60;
        let isTimerRunning = false;
        let timerInterval = null;
        let updatePollInterval = null;

        function escapeJsString(str) { return String(str || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;'); }
        function escapeHtml(str) { return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;'); }

        function openModal(modalId) {
            const el = document.getElementById(modalId);
            if (el) { el.classList.remove('hidden'); el.classList.add('flex'); }
        }
        function closeModal(modalId) {
            const el = document.getElementById(modalId);
            if (el) { el.classList.add('hidden'); el.classList.remove('flex'); }
        }

        /* ---------------- AUTO UPDATER JS ---------------- */
        async function openUpdateModal() {
            openModal('update-modal');
            await checkUpdateManual();
        }

        async function checkUpdateManual() {
            const body = document.getElementById('update-modal-body');
            const btnInst = document.getElementById('btn-install-update-now');
            if (!body) return;
            body.innerHTML = '<p class="text-gray-600 text-xs flex items-center gap-2"><i class="fa-solid fa-spinner fa-spin text-indigo-600"></i> Consultando atualizacoes na nuvem...</p>';
            if (btnInst) btnInst.classList.add('hidden');

            try {
                if (window.pywebview && window.pywebview.api) {
                    const res = await window.pywebview.api.update_check_now();
                    renderUpdateModalState(res);
                }
            } catch (e) {
                body.innerHTML = `<p class="text-rose-600 text-xs font-semibold">Erro ao checar atualizacoes: ${escapeHtml(e)}</p>`;
            }
        }

        function renderUpdateModalState(res) {
            const body = document.getElementById('update-modal-body');
            const btnInst = document.getElementById('btn-install-update-now');
            const indicator = document.getElementById('update-topbar-indicator');
            const topbarText = document.getElementById('update-topbar-text');
            if (!body) return;

            if (res.status === 'update_available') {
                if (indicator && topbarText) {
                    topbarText.innerText = `Nova versao ${res.latest} disponivel!`;
                    indicator.classList.remove('hidden');
                    indicator.classList.add('flex');
                }
                body.innerHTML = `
                    <div class="space-y-3">
                        <div class="p-3 bg-indigo-50 border border-indigo-200 rounded-lg">
                            <div class="font-bold text-indigo-900 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-sparkles text-indigo-600"></i>
                                <span>Nova Versao ${escapeHtml(res.latest)} Disponivel!</span>
                            </div>
                            <p class="text-[11px] text-indigo-700 mt-1">Sua versao atual e <b>${escapeHtml(res.current)}</b>.</p>
                        </div>
                        ${res.notes ? `
                            <div>
                                <label class="font-bold text-gray-700 text-xs block mb-1">Notas da Versao:</label>
                                <div class="p-2.5 bg-gray-50 border border-gray-200 rounded text-[11px] text-gray-700 font-mono whitespace-pre-wrap">${escapeHtml(res.notes)}</div>
                            </div>
                        ` : ''}
                    </div>
                `;
                if (btnInst) btnInst.classList.remove('hidden');
            } else if (res.status === 'up_to_date') {
                if (indicator) indicator.classList.add('hidden');
                body.innerHTML = `
                    <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg flex items-center gap-2.5">
                        <i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>
                        <div>
                            <p class="font-bold text-emerald-900 text-xs">Seu Cogni esta atualizado!</p>
                            <p class="text-[11px] text-emerald-700">Voce esta utilizando a versao mais recente (${escapeHtml(res.current)}).</p>
                        </div>
                    </div>
                `;
            } else {
                body.innerHTML = `
                    <div class="p-3 bg-amber-50 border border-amber-200 rounded-lg">
                        <p class="font-bold text-amber-900 text-xs">Nao foi possivel consultar atualizacoes.</p>
                        <p class="text-[11px] text-amber-700 mt-0.5">${escapeHtml(res.message || 'Verifique sua conexao de rede.')}</p>
                    </div>
                `;
            }
        }

        async function installUpdateNow() {
            const btnInst = document.getElementById('btn-install-update-now');
            const progressBox = document.getElementById('update-progress-box');
            if (btnInst) btnInst.classList.add('hidden');
            if (progressBox) progressBox.classList.remove('hidden');

            try {
                if (window.pywebview && window.pywebview.api) {
                    await window.pywebview.api.update_install();
                    if (updatePollInterval) clearInterval(updatePollInterval);
                    updatePollInterval = setInterval(pollUpdateProgress, 500);
                }
            } catch (e) {
                alert("Erro ao iniciar instalacao: " + e);
            }
        }

        async function pollUpdateProgress() {
            try {
                if (window.pywebview && window.pywebview.api) {
                    const prog = await window.pywebview.api.update_progress();
                    const label = document.getElementById('update-progress-label');
                    const pct = document.getElementById('update-progress-pct');
                    const bar = document.getElementById('update-progress-bar');
                    const submsg = document.getElementById('update-progress-submsg');

                    if (prog) {
                        if (pct) pct.innerText = `${prog.pct || 0}%`;
                        if (bar) bar.style.width = `${prog.pct || 0}%`;
                        if (label) label.innerText = prog.mensagem || 'Baixando...';
                        if (submsg) submsg.innerText = prog.fase || '';

                        if (prog.fase === 'error') {
                            clearInterval(updatePollInterval);
                            alert("Erro na atualizacao: " + (prog.mensagem || "Falha desconhecida."));
                        }
                    }
                }
            } catch (e) { console.warn("Erro ao ler progresso:", e); }
        }

        /* Initialization logic */
        window.addEventListener('pywebviewready', () => { loadStateFromDiskSafely(); });
        setTimeout(() => { if (!isAppDataLoadedFromDisk) loadStateFromDiskSafely(); }, 1500);

        async function loadStateFromDiskSafely() {
            if (isAppDataLoadedFromDisk || isInitializingFromDisk) return;
            isInitializingFromDisk = true;
            try {
                if (window.pywebview && window.pywebview.api) {
                    const raw = await window.pywebview.api.load_state_from_disk();
                    if (raw && raw !== '{}') {
                        appData = JSON.parse(raw);
                    }
                }
            } catch(e) { console.warn("Load state:", e); }
            isAppDataLoadedFromDisk = true;
            isInitializingFromDisk = false;
            initApp();
        }

        function initApp() {
            applyAccentTheme(appData.accentTheme || 'indigo');
            renderDashboardStats();
            // Checagem em segundo plano de novas versoes
            setTimeout(async () => {
                try {
                    if (window.pywebview && window.pywebview.api) {
                        const cached = await window.pywebview.api.update_cached();
                        if (cached && cached.status === 'update_available') {
                            renderUpdateModalState(cached);
                        }
                    }
                } catch(e){}
            }, 3000);
        }

        function triggerAutoSave() {
            if (!isAppDataLoadedFromDisk) return;
            const jsonStr = JSON.stringify(appData, null, 2);
            if (window.pywebview && window.pywebview.api) {
                window.pywebview.api.save_state_to_disk(jsonStr);
            }
        }

        function renderDashboardStats() {
            const completed = (appData.tasks || []).filter(t => t.status === 'Concluido').length;
            const total = (appData.tasks || []).length;
            const rate = total > 0 ? Math.round((completed / total) * 100) : 0;
            const elComp = document.getElementById('kpi-completed-tasks');
            const elRate = document.getElementById('kpi-completion-rate');
            if (elComp) elComp.innerText = `${completed}/${total}`;
            if (elRate) elRate.innerText = `${rate}%`;
        }

        function switchTab(tabName) {
            document.querySelectorAll('.view-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('bg-notion-hover'));
            const activeView = document.getElementById(`view-${tabName}`);
            const activeBtn = document.getElementById(`nav-${tabName}`);
            if (activeView) activeView.classList.remove('hidden');
            if (activeBtn) activeBtn.classList.add('bg-notion-hover');
        }

        function toggleTimer() {
            const btnText = document.getElementById('timer-btn-text');
            const iconPlay = document.getElementById('timer-icon-play');
            const statusLabel = document.getElementById('timer-status-label');
            if (isTimerRunning) {
                clearInterval(timerInterval);
                isTimerRunning = false;
                if (btnText) btnText.innerText = "Continuar Sessao";
                if (iconPlay) iconPlay.className = "fa-solid fa-play";
                if (statusLabel) statusLabel.innerText = "Sessao Pausada";
            } else {
                isTimerRunning = true;
                if (btnText) btnText.innerText = "Pausar";
                if (iconPlay) iconPlay.className = "fa-solid fa-pause";
                if (statusLabel) statusLabel.innerText = "Foco Ativo...";
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        updateTimerDisplay();
                    } else {
                        clearInterval(timerInterval);
                        isTimerRunning = false;
                        if (btnText) btnText.innerText = "Iniciar Sessao";
                        if (iconPlay) iconPlay.className = "fa-solid fa-play";
                        if (statusLabel) statusLabel.innerText = "Sessao Concluida!";
                    }
                }, 1000);
            }
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isTimerRunning = false;
            timerSeconds = timerDurationConfigured;
            updateTimerDisplay();
            const btnText = document.getElementById('timer-btn-text');
            const statusLabel = document.getElementById('timer-status-label');
            if (btnText) btnText.innerText = "Iniciar Sessao";
            if (statusLabel) statusLabel.innerText = "Pronto para iniciar";
        }

        function updateTimerDisplay() {
            const m = String(Math.floor(timerSeconds / 60)).padStart(2, '0');
            const s = String(timerSeconds % 60).padStart(2, '0');
            const disp = document.getElementById('timer-display');
            if (disp) disp.innerText = `${m}:${s}`;
        }
    </script>
</body>
</html>
"""

def main():
    api = CogniDesktopAPI()
    window = webview.create_window(
        title='Cogni',
        html=HTML_CONTENT,
        js_api=api,
        width=1280,
        height=800,
        min_size=(900, 600),
        resizable=True
    )
    webview.start(debug=False)

if __name__ == '__main__':
    main()